#: PySubtrans/Transcription/Providers/Provider_Gemini.py:59
msgid "\n            <p>To use this provider you need a <a href=\"https://aistudio.google.com/app/apikey\">Google AI Studio API key</a>.</p>\n            "
msgstr ""
"\n"
"            <p>Para usar este proveedor necesitas una <a href=\\\"https://aistudio.google.com/app/apikey\\\">clave de API de Google AI Studio</a>.</p>\n"
"            "

#: PySubtrans/Transcription/Providers/Provider_Gemini.py:54
msgid "\n            <p>Transcribe with Gemini 3.5 Transcribe (word timestamps, speaker diarization).</p>\n            <p>Gemini Transcribe has strict rate limits and daily caps, so large chunks are recommended.</p>\n            "
msgstr ""
"\n"
"            <p>Transcribe con Gemini 3.5 Transcribe (marcas de tiempo por palabra, diarización de hablantes).</p>\n"
"            <p>Gemini Transcribe tiene límites de tasa estrictos y topes diarios, por lo que se recomiendan fragmentos grandes.</p>\n"
"            "

#: PySubtrans/Transcription/Providers/Provider_QwenLocal.py:37
msgid "\n        <p>Transcribe audio on your local machine with Qwen3-ASR.</p>\n        <p>The first transcription downloads model weights (~6 GB) to the\n        Hugging Face cache. Subsequent runs reuse the cached files.</p>\n        "
msgstr ""
"\n"
"        <p>Transcribe audio en tu máquina local con Qwen3-ASR.</p>\n"
"        <p>La primera transcripción descarga los pesos del modelo (~6 GB) a la\n"
"        caché de Hugging Face. Las ejecuciones posteriores reutilizan los archivos en caché.</p>\n"
"        "

#: PySubtrans/Transcription/Providers/Provider_OpenRouter.py:24
msgid "\n    <p>To use this provider you need <a href=\"https://openrouter.ai/keys\">an OpenRouter API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Para usar este proveedor necesitas <a href=\\\"https://openrouter.ai/keys\\\">una clave de API de OpenRouter</a>.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenAI.py:24
msgid "\n    <p>To use this provider you need <a href=\"https://platform.openai.com/account/api-keys\">an OpenAI API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Para usar este proveedor necesitas <a href=\\\"https://platform.openai.com/account/api-keys\\\">una clave de API de OpenAI</a>.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_Muse.py:24
msgid "\n    <p>To use this provider you need a Meta <a href=\"https://dev.meta.ai/\">Model API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Para usar este proveedor necesitas una <a href=\\\"https://dev.meta.ai/\\\">clave de API del Modelo Meta</a>.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_Muse.py:19
msgid "\n    <p>Transcribe with Meta Muse Voice Transcribe.</p>\n    <p>Note that Muse does not provide word-level timings, so subtitle timing is \"best effort\".</p>\n    "
msgstr ""
"\n"
"    <p>Transcribe con Meta Muse Voice Transcribe.</p>\n"
"    <p>Ten en cuenta que Muse no proporciona tiempos a nivel de palabra, por lo que el tiempo de los subtítulos es \\\"mejor esfuerzo\\\".</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenAI.py:19
msgid "\n    <p>Transcribe with OpenAI speech-to-text models.</p>\n    <p>Currently experimental and untested due to expired API credits. Please report your experience!</p>\n    "
msgstr ""
"\n"
"    <p>Transcribe con los modelos de voz a texto de OpenAI.</p>\n"
"    <p>Actualmente experimental y no probado debido a créditos de API caducados. ¡Informa de tu experiencia!</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenRouter.py:19
msgid "\n    <p>Transcribe with OpenRouter speech-to-text models.</p>\n    <p>Word timestamps and diarization depend on the selected model.</p>\n    "
msgstr ""
"\n"
"    <p>Transcribe con los modelos de voz a texto de OpenRouter.</p>\n"
"    <p>Las marcas de tiempo por palabra y la diarización dependen del modelo seleccionado.</p>\n"
"    "

