#: PySubtrans/Transcription/Providers/Provider_Gemini.py:192
msgid "\n            <p>To use this provider you need a <a href=\"https://aistudio.google.com/app/apikey\">Google AI Studio API key</a>.</p>\n            "
msgstr ""
"\n"
"            <p>Pro používání tohoto poskytovatele potřebujete <a href=\\\"https://aistudio.google.com/app/apikey\\\">API klíč Google AI Studio</a>.</p>\n"
"            "

#: PySubtrans/Transcription/Providers/Provider_QwenLocal.py:64
msgid "\n            <p>Transcribe audio on your local machine with Qwen3-ASR.</p>\n            "
msgstr "\n            <p>Přepisujte audio na vašem místním počítači pomocí Qwen3-ASR.</p>\n            "

#: PySubtrans/Transcription/Providers/Provider_Gemini.py:187
msgid "\n            <p>Transcribe with Gemini 3.5 Transcribe (word timestamps, speaker diarization).</p>\n            <p>Requires a <a href=\"https://aistudio.google.com/app/apikey\">Google AI Studio API key</a>.</p>\n            "
msgstr ""
"\n"
"            <p>Transkribujte pomocí Gemini 3.5 Transcribe (časová razítka slov, diarizace mluvčích).</p>\n"
"            <p>Vyžaduje <a href=\\\"https://aistudio.google.com/app/apikey\\\">API klíč Google AI Studio</a>.</p>\n"
"            "

#: PySubtrans/Transcription/Providers/Provider_OpenRouter.py:29
msgid "\n    <p>To use this provider you need <a href=\"https://openrouter.ai/keys\">an OpenRouter API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Pro používání tohoto poskytovatele potřebujete <a href=\\\"https://openrouter.ai/keys\\\">API klíč OpenRouter</a>.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenAI.py:82
msgid "\n    <p>To use this provider you need <a href=\"https://platform.openai.com/account/api-keys\">an OpenAI API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Pro používání tohoto poskytovatele potřebujete <a href=\\\"https://platform.openai.com/account/api-keys\\\">API klíč OpenAI</a>.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_Muse.py:24
msgid "\n    <p>To use this provider you need a Meta <a href=\"https://dev.meta.ai/\">Model API key</a>.</p>\n    "
msgstr ""
"\n"
"    <p>Pro používání tohoto poskytovatele potřebujete <a href=\\\"https://dev.meta.ai/\\\">API klíč Model</a> od Meta.</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_Muse.py:19
msgid "\n    <p>Transcribe with Meta Muse Voice Transcribe.</p>\n    <p>Note that Muse does not provide word-level timings, so subtitle timing is \"best effort\".</p>\n    "
msgstr ""
"\n"
"    <p>Transkribujte pomocí Meta Muse Voice Transcribe.</p>\n"
"    <p>Upozorňujeme, že Muse neposkytuje časování na úrovni slov, takže časování titulků je pouze \\\"co nejlepší snaha\\\".</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenAI.py:77
msgid "\n    <p>Transcribe with OpenAI speech-to-text models.</p>\n    <p>Currently experimental and untested due to expired API credits. Please report your experiences!</p>\n    "
msgstr ""
"\n"
"    <p>Transkribujte pomocí modelů OpenAI pro převod řeči na text.</p>\n"
"    <p>V současnosti experimentální a netestované kvůli vypršeným API kreditům. Podělte se prosím o své zkušenosti!</p>\n"
"    "

#: PySubtrans/Transcription/Providers/Provider_OpenRouter.py:23
msgid "\n    <p>Transcribe with OpenRouter speech-to-text models.</p>\n    <p>Word timestamps and diarization depend on the selected model.</p>\n    <p>You must have credit to use OpenRouter models.</p>\n    "
msgstr ""
"\n"
"    <p>Transkribujte pomocí modelů OpenRouter pro převod řeči na text.</p>\n"
"    <p>Časová razítka slov a diarizace závisí na vybraném modelu.</p>\n"
"    <p>Pro používání modelů OpenRouter musíte mít kredit.</p>\n"
"    "

